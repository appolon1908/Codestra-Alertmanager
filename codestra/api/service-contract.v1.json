      "application",
      "service",
      "environment",
      "server",
      "region",
      "deployment"
    ],
    "propagateHeaders": [
      "X-Correlation-ID",
      "traceparent"
    ],
    "protectedNonIndexedFields": [
      "request_id",
      "trace_id",
      "tenant_id"
    ],
    "structuredFields": [
      "correlation_id",
      "request_id",
      "trace_id",
      "tenant_id"
    ]
  },
  "deploymentClass": "central",
  "displayName": "Alertmanager",
