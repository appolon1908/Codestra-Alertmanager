      "mutating": false,
      "peer": "prometheus",
      "protocol": "alertmanager-http-api",
      "purpose": "receive evaluated alerts",
      "signal": "alerts"
    },
    {
      "direction": "inbound",
      "mutating": false,
      "peer": "grafana",
      "protocol": "alertmanager-http-api",
      "purpose": "serve read-only alert state",
      "signal": "alerts"
    },
    {
      "direction": "outbound",
      "mutating": false,
      "peer": "codestra-middleware",
      "protocol": "https-webhook",
      "purpose": "route notifications through the governed communications path",
      "signal": "alerts"
    }
  ],
  "managementReadback": {
    "allowsMutation": false,
    "controlApiOwner": "appolon1908-hue/Codestra-Telemetry",
